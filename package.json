{
  "name": "virtual-tavern",
  "version": "0.62.1",
  "private": true,
  "description": "A private, self-hosted tavern for playing party games with friends.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.22.1",
    "pnpm": "11.28.5"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @vt/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "aws4fetch": "^1.0.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
