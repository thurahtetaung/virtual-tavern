# Copy to .env (never commit it).
#
# This file is read by docker compose (env_file) and scripts/deploy.sh only.
# Nothing loads it in development: for `pnpm dev`, export variables in your shell
# (e.g. `ADMIN_PASSWORD=... pnpm dev`).
#
# The Dockerfile fixes PORT=3000, DATABASE_PATH=/data/tavern.db, WEB_DIST=/app/web,
# APP_VERSION (the image tag) and NODE_ENV=production; don't set those here.

# Admin area for managing word lists and the back-room password. Leave empty to disable.
ADMIN_PASSWORD=
# Signs admin cookies. Generate with: openssl rand -hex 32
# Required in production once ADMIN_PASSWORD is set (the server refuses to start without it).
SESSION_SECRET=

# Image version to run; scripts/deploy.sh keeps this up to date.
IMAGE_TAG=latest

# Loopback port the app is published on; point the Cloudflare tunnel's hostname at http://localhost:<APP_PORT>.
APP_PORT=3000

# Optional
# LOG_LEVEL=info
# ROOM_IDLE_DAYS=7
# How many database backups `node dist/backup.js` keeps in /data/backups.
# BACKUP_KEEP=14

# Private game assets (back room art) in Cloudflare R2. Use an Object Read token
# scoped to the bucket; see docs/deployment.md §5. The back room works without
# these, just with no pictures.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
