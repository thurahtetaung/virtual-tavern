# Copy to .env (never commit it).

# Admin area for managing word lists. Leave empty to disable.
ADMIN_PASSWORD=
# Signs admin cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Image version to run; scripts/deploy.sh keeps this up to date.
IMAGE_TAG=latest

# Cloudflare tunnel (production). Enables the cloudflared service.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=

# Optional
# LOG_LEVEL=info
# ROOM_IDLE_DAYS=7
# APP_PORT=3000
