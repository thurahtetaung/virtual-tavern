# Copy to .env (never commit it).

# Admin area for managing word lists. Leave empty to disable.
ADMIN_PASSWORD=
# Signs admin cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Image version to run; scripts/deploy.sh keeps this up to date.
IMAGE_TAG=latest

# Loopback port the app is published on; point the Cloudflare tunnel's hostname at http://localhost:<APP_PORT>.
APP_PORT=3000

# Optional
# LOG_LEVEL=info
# ROOM_IDLE_DAYS=7
